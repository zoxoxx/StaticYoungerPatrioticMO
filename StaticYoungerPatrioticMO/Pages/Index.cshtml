@page
@model StaticYoungerPatrioticMO.Pages.IndexModel
@{
    ViewData["Title"] = "ИСКРА — программа патриотического воспитания";
}

<section class="hero" id="hero">
    <canvas id="sparks" class="hero-canvas" aria-hidden="true"></canvas>
    <div class="container hero-inner">
        <div class="hero-emblem" aria-hidden="true">
            <svg viewBox="0 0 240 260"><use href="#spark-emblem" /></svg>
        </div>
        <h1 class="hero-title">ИСКРА</h1>
        <div class="hero-divider" aria-hidden="true">
            <span></span><svg viewBox="0 0 24 24"><use href="#icon-spark" /></svg><span></span>
        </div>
        <p class="hero-sub">Программа нравственного, патриотического и&nbsp;духовного воспитания современной молодёжи</p>
        <div class="hero-actions">
            <a class="btn btn-ghost" href="#about">О программе</a>
        </div>
        <div class="hero-badges">
            <span class="badge">От @Model.Info.AgeMin до @Model.Info.AgeMax лет</span>
            <span class="badge">@Model.Ranks.Count рангов роста</span>
            <span class="badge">Участие бесплатное</span>
        </div>
    </div>
    <a class="scroll-hint" href="#stats" aria-label="Прокрутить вниз"><span></span></a>
</section>

<section class="stats" id="stats" data-animate>
    <div class="container stats-grid">
        <div class="stat reveal">
            <p class="stat-num">@Model.Info.AgeMin–@Model.Info.AgeMax</p>
            <p class="stat-label">возраст участников программы</p>
        </div>
        <div class="stat reveal" style="@Model.StatsDelay1">
            <p class="stat-num"><span data-count="@Model.Ranks.Count">0</span></p>
            <p class="stat-label">рангов в системе «искровцев»</p>
        </div>
        <div class="stat reveal" style="@Model.StatsDelay2">
            <p class="stat-num">Бесплатно</p>
            <p class="stat-label">стоимость участия</p>
        </div>
    </div>
</section>

<section class="section" id="about" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">О программе</h2>
            </div>
        </header>

        <blockquote class="epigraph reveal">
            @Model.Quote
            <cite>@Model.QuoteAuthor</cite>
        </blockquote>

        <p class="about-intro reveal">@Model.AboutIntro</p>

        <div class="num-cards">
            @for (int i = 0; i < Model.AboutBlocks.Count; i++)
            {
                var b = Model.AboutBlocks[i];
                var d = i * 110;
                <article class="card num-card reveal" style="--d:@(d)ms">
                    <span class="num">@(i + 1)</span>
                    <h3 class="card-title">@b.Title</h3>
                    @foreach (var p in b.Paragraphs)
                    {
                        <p>@p</p>
                    }
                    @if (b.Bullets.Count > 0)
                    {
                        <ul class="list-mark">
                            @foreach (var li in b.Bullets)
                            {
                                <li>@li</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>

        <h3 class="sub-title reveal">Цели программы</h3>
        <div class="about-grid">
            <article class="card reveal">
                <h3 class="card-title"><svg class="ci" aria-hidden="true"><use href="#icon-star" /></svg> Зачем мы это делаем</h3>
                <ul class="list-mark">
                    @foreach (var g in Model.Goals)
                    {
                        <li>@g</li>
                    }
                </ul>
            </article>

            <article class="card reveal" style="@Model.AboutRealizationDelay">
                <h3 class="card-title"><svg class="ci" aria-hidden="true"><use href="#icon-book" /></svg> Реализация</h3>
                <ul class="list-mark">
                    @foreach (var r in Model.Realization)
                    {
                        <li>@r</li>
                    }
                </ul>
                <div class="age-chip">
                    <span class="age-chip-num">@Model.Info.AgeMin–@Model.Info.AgeMax</span>
                    <span class="age-chip-text">лет — возраст участников</span>
                </div>
            </article>
        </div>

        <div class="free-banner reveal">
            <svg class="free-banner-spark" aria-hidden="true"><use href="#icon-spark" /></svg>
            <p>Участие в программе «ИСКРА» — <strong>бесплатное!</strong></p>
        </div>
    </div>
</section>

<section class="section section-tint" id="tasks" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Виды заданий</h2>
                <p class="section-lead">Задания в дневнике «искровца» чередуются: тело, ремесло и дух получают равное внимание.</p>
            </div>
        </header>

        <div class="grid-3">
            @foreach (var t in Model.Tasks)
            {
                <article class="card task t-@t.Id reveal">
                    <div class="task-icon"><svg aria-hidden="true"><use href="#@t.Icon" /></svg></div>
                    <h3 class="card-title">@t.Title</h3>
                    <p class="task-lead">@t.Lead</p>
                    <ul class="list-mark">
                        @foreach (var item in t.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<section class="section" id="ranks" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Система рангов «искровцев»</h2>
                <p class="section-lead">Путь от новобранца до пионера: возраст, нормативы, испытания.</p>
            </div>
        </header>

        <div class="ranks">
            @foreach (var rank in Model.Ranks)
            {
                <div class="rank reveal">
                    <div class="rank-badge">
                        @if (rank.Pips == 0)
                        {
                            <svg aria-hidden="true"><use href="#icon-spark" /></svg>
                        }
                        else
                        {
                            <span class="pips">
                                @for (var p = 0; p < rank.Pips; p++)
                                {
                                    <span class="pip"></span>
                                }
                            </span>
                        }
                    </div>
                    <p class="rank-name">@rank.Name</p>
                    <span class="rank-years">@rank.Age</span>
                    <p class="rank-desc">@rank.Description</p>
                </div>
            }
        </div>

        <div class="norms">
            @foreach (var rank in Model.Ranks)
            {
                <details class="norm-card reveal" data-group="norms">
                    <summary><span class="norm-title">Нормативы: @rank.Name</span><span class="rank-years">@rank.Age</span></summary>
                    <div class="norm-body">
                        @if (rank.Norms.Physical.Count > 0)
                        {
                            <p class="norm-label">Физические нормативы</p>
                            <table class="norm-table">
                                <tbody>
                                    @foreach (var row in rank.Norms.Physical)
                                    {
                                        <tr><td>@row.Exercise</td><td>@row.Value</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (rank.Norms.Group.Count > 0)
                        {
                            <p class="norm-label">Посещение в составе организованной группы</p>
                            <ul class="list-mark">
                                @foreach (var g in rank.Norms.Group)
                                {
                                    <li>@g</li>
                                }
                            </ul>
                        }
                        @if (rank.Norms.Individual.Count > 0)
                        {
                            <p class="norm-label">Индивидуальные задания</p>
                            <ul class="list-mark">
                                @foreach (var g in rank.Norms.Individual)
                                {
                                    <li>@g</li>
                                }
                            </ul>
                        }
                        @if (rank.Norms.Extra.Count > 0)
                        {
                            <p class="norm-label">Дополнительные испытания</p>
                            <ul class="list-mark">
                                @foreach (var g in rank.Norms.Extra)
                                {
                                    <li>@g</li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrEmpty(rank.Norms.Reward))
                        {
                            <p class="norm-reward">@rank.Norms.Reward</p>
                        }
                    </div>
                </details>
            }
        </div>

        <div class="rules-grid">
            <article class="card reveal">
                <h3 class="card-title"><svg class="ci" aria-hidden="true"><use href="#icon-check" /></svg> Для получения звания «Искровец»</h3>
                <ul class="list-check">
                    @foreach (var rule in Model.RankRules)
                    {
                        <li>@rule</li>
                    }
                </ul>
                <p class="card-note">Допуск к получению очередного звания даёт командир Народной Дружины «Калининская».</p>
            </article>
            <article class="card card-accent reveal" style="@Model.RulesAccentDelay">
                <h3 class="card-title"><svg class="ci" aria-hidden="true"><use href="#icon-shield" /></svg> Где сдаются нормативы</h3>
                <p>Сдача нормативов проходит на базе <strong>ЦФКиС Калининского района СПб</strong> и <strong>33-й Ордена Жукова бригады оперативного назначения СЗФО Росгвардии</strong>.</p>
                <p>После сдачи нормативов «Искровец» получает <strong>знаки отличия на форму</strong>, а <strong>Инжинер</strong> и <strong>Пионер</strong> получают <strong>индивидуальную форму</strong>.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section-tint" id="support" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Нас поддерживают</h2>
                <p class="section-lead">Нажмите «Подробнее», чтобы посмотреть фотографии и описание.</p>
            </div>
        </header>

        <div class="grid-auto">
            @foreach (var s in Model.Supporters)
            {
                <article class="card support-card reveal">
                    <div class="support-head">
                        <svg class="support-icon" aria-hidden="true"><use href="#icon-shield" /></svg>
                        <span class="name">@s.Name</span>
                        <button type="button" class="more" data-name="@s.Name" data-desc="@Model.PartnerDescription">Подробнее</button>
                    </div>
                </article>
            }
        </div>

        <h3 class="sub-title reveal">Наши партнёры</h3>
        <div class="grid-auto">
            @foreach (var p in Model.Partners)
            {
                <article class="card support-card reveal">
                    <div class="support-head">
                        <svg class="support-icon" aria-hidden="true"><use href="#icon-star" /></svg>
                        <span class="name">@p.Name</span>
                        <button type="button" class="more" data-name="@p.Name" data-desc="@Model.PartnerDescription">Подробнее</button>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section" id="join" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Как стать участником программы</h2>
                <p class="section-lead">Узнать о наличии свободных мест и подать заявление можно по любому из адресов ниже.</p>
            </div>
        </header>

        <ol class="steps">
            <li class="reveal"><span class="step-num">1</span>Выберите удобную площадку приёма</li>
            <li class="reveal" style="@Model.StepsDelay1"><span class="step-num">2</span>Подайте заявление и получите дневник заданий</li>
            <li class="reveal" style="@Model.StepsDelay2"><span class="step-num">3</span>Выполняйте физические, творческие и культурные задания</li>
            <li class="reveal" style="@Model.StepsDelay3"><span class="step-num">4</span>Проходите испытания, сдавайте нормативы и получайте звания</li>
        </ol>

        <div class="grid-2">
            @foreach (var cp in Model.JoinPoints)
            {
                <article class="card addr-card reveal">
                    <div class="addr-icon"><svg aria-hidden="true"><use href="#icon-pin" /></svg></div>
                    <div>
                        <h3 class="addr-title">@cp.Title</h3>
                        <p class="addr-text">@cp.Address</p>
                        <p class="addr-note">@cp.Note</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-tint" id="social" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Мы в социальных сетях</h2>
                <p class="section-lead">Подписывайтесь: отчёты с мероприятий, фото и анонсы — там.</p>
            </div>
        </header>

        <div class="social-grid">
            @foreach (var sl in Model.Socials)
            {
                <a class="social-card social-@sl.Id reveal" href="@sl.Url" target="_blank" rel="noopener">
                    @sl.Name
                    <small>@sl.Hint</small>
                </a>
            }
        </div>
    </div>
</section>

<section class="section" id="trustees" data-animate>
    <svg class="watermark" aria-hidden="true"><use href="#spark-emblem" /></svg>
    <div class="container">
        <header class="section-head">
            <svg class="section-spark" aria-hidden="true"><use href="#spark-emblem" /></svg>
            <div>
                <h2 class="section-title">Попечительский совет программы «ИСКРА»</h2>
                <p class="section-lead">Люди, которые поддерживают программу делом и словом.</p>
            </div>
        </header>

        <div class="trustees-grid">
            @foreach (var t in Model.Trustees)
            {
                <article class="card trustee-card reveal">
                    <img class="trustee-photo" src="@t.Photo" alt="@t.Name" loading="lazy" />
                    <p class="trustee-name">@t.Name</p>
                    <p class="trustee-role">@t.Role</p>
                    <details>
                        <summary>Подробнее</summary>
                        <p class="trustee-details">@t.Details</p>
                    </details>
                </article>
            }
        </div>
    </div>
</section>

<!-- Общая модалка «Подробнее» (вне карточек, поэтому fixed работает от экрана) -->
<div class="support-modal-backdrop" id="supportModal" hidden>
    <div class="support-modal">
        <button type="button" class="support-close" aria-label="Закрыть">×</button>
        <h4 class="modal-title" id="supportModalTitle"></h4>
        <div class="photos-mini">
            @foreach (var src in Model.PartnerPhotos)
            {
                <img src="@src" alt="" loading="lazy" />
            }
        </div>
        <p class="support-desc" id="supportModalDesc"></p>
    </div>
</div>